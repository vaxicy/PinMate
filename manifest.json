{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "1.1.2",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "PinMate"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.pinterest.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "js/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.pinterest.com/*"
      ],
      "js": ["js/i18n.js", "js/storage.js", "js/content.js"],
      "css": ["css/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html"
}
